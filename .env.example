# ── claw configuration ────────────────────────────────────────────────
# Copy this file to `.env` and edit it. `.env` is gitignored (keep secrets there).
# Compose reads `.env` automatically.

# Web login token.
# Leave this commented to have claw GENERATE one on first start, print it to the
# logs, and save it to /data/auth_token (reused across restarts). To choose your
# own, uncomment and set a long random value:
# CLAW_AUTH_TOKEN=change-me-to-a-long-random-string

# Web UI port.
CLAW_PORT=8080

# Your IANA timezone — used for scheduled-task next-fire (e.g. Europe/Paris).
CLAW_TIMEZONE=UTC

# Optional default inference target for agents that don't set their own.
# Prefer configuring each agent in the web admin; leave commented to skip.
CLAW_DEFAULT_ENDPOINT=openrouter
CLAW_DEFAULT_MODEL=google/gemma-2-9b-it
